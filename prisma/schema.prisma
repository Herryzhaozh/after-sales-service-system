// After-Sales Service System — Prisma schema
// Stack: NestJS + PostgreSQL + Prisma + Redis + WebSocket

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Ticket {
  id           String       @id @default(cuid())
  customerId   String
  title        String
  description  String?
  status       TicketStatus @default(RECEIVED)
  technicianId String?
  slaDueAt     DateTime
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([status])
  @@index([technicianId])
}

enum TicketStatus {
  RECEIVED
  TRIAGED
  ASSIGNED
  DISPATCHED
  EN_ROUTE
  ON_SITE
  REPAIRING
  WAITING_PARTS
  QUALITY_CHECK
  COMPLETED
  RATED
  CLOSED
}

model Technician {
  id        String   @id @default(cuid())
  name      String
  skills    String[]
  latitude  Float?
  longitude Float?
  available Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Part {
  id        String   @id @default(cuid())
  name      String
  stock     Int      @default(0)
  reserved  Int      @default(0)
  updatedAt DateTime @updatedAt
}
